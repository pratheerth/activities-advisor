# Live mode calls the real model, weather, and search APIs.
APP_MODE=live
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4.1
OPENWEATHER_API_KEY=replace-with-your-openweather-key
TAVILY_API_KEY=replace-with-your-tavily-key
# Optional. By default, state is stored in runtime/advisor.db in this project.
# ADVISOR_DB=./runtime/advisor.db
